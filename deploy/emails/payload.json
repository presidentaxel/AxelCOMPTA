{"mailer_subjects_confirmation": "Confirmez votre adresse", "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Confirmez votre adresse</title>\n</head>\n<body style=\"margin:0;padding:0;background:#FBFAF8;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">Confirmez votre adresse pour ouvrir votre compte AxeL.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FBFAF8;\">\n<tr><td align=\"center\" style=\"padding:40px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#FFFFFF;border:1px solid #E7E5E0;border-radius:12px;\">\n<tr><td style=\"height:3px;background:#C2410C;font-size:0;line-height:0;\">&nbsp;</td></tr>\n<tr><td style=\"padding:28px 32px 0 32px;\">\n<span style=\"font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:15px;font-weight:600;letter-spacing:-0.02em;color:#111111;\">AxeL</span>\n<span style=\"display:inline-block;margin-left:8px;padding:1px 7px;border:1px solid #D4D1CA;border-radius:999px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#66645F;\">Alpha</span>\n</td></tr>\n<tr><td style=\"padding:22px 32px 0 32px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#C2410C;\">Compte</td></tr>\n<tr><td style=\"padding:8px 32px 0 32px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:22px;font-weight:600;letter-spacing:-0.02em;line-height:1.25;color:#111111;\">Confirmez votre adresse</td></tr>\n<tr><td style=\"padding:12px 32px 0 32px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Seg