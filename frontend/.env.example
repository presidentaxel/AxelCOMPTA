NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Connexion chauffeur (doc 17 §9 bloc B, doc 19 §4/§5) — appels REST directs
# à Supabase Auth depuis le navigateur, jamais le SDK @supabase/supabase-js
# (cohérent avec le backend, ADR-003 : pas de lock-in SDK). La clé anon est
# faite pour être exposée côté client (contrairement à la service role key,
# qui reste backend-only). Mêmes valeurs que backend/.env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Observabilité navigateur (doc 15). Vide : aucune erreur n'est envoyée.
NEXT_PUBLIC_SENTRY_DSN=

# Logo.dev — logos Uber, Bolt, Heetch… sur la fiche (https://www.logo.dev/).
# Clé publiable, préfixe pk_. Dashboard › API keys › Publishable key.
# Elle est faite pour le navigateur (paramètre token des images img.logo.dev).
# La clé secrète (sk_) ne va pas ici : elle reste dans le .env du backend.
# Après modification, redémarrer `next dev` : Next fige les NEXT_PUBLIC au démarrage.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
