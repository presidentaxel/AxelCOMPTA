{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-unit",
    "rootDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "lib/messages-auth.ts",
    "lib/messages-auth.test.ts",
    "lib/activite-url.ts",
    "lib/activite-url.test.ts",
    "lib/saisie-chauffeur.ts",
    "lib/saisie-chauffeur.test.ts",
    "lib/montant.ts",
    "lib/montant.test.ts",
    "lib/comptes-bancaires.ts",
    "lib/comptes-bancaires.test.ts"
  ]
}
