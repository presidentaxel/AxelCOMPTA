# Poste de développement. Copier en `.env.dev` (non versionné).
# Chargé après `.env`, et prioritaire : une ligne décommentée remplace
# la même variable de `.env`, même si elle est vide. Laisser en commentaire
# ce qui doit rester celui de `.env`.
#
# ENV=dev coupe l'envoi Sentry même si SENTRY_DSN est posé dans `.env`.
# Le front Next ne lit pas ce fichier : ses NEXT_PUBLIC_* vont dans
# frontend/.env.local.
# =============================================================================

ENV=dev

# Liens des e-mails (invitations, rappels) et origine CORS du dossier.
# En production `.env` peut pointer compta / app-compta : ici on reste
# sur le poste. Les deux portes sont le même Next.
AXELCOMPTA_URL_APP=http://localhost:3000
AXELCOMPTA_URL_DOSSIER=http://localhost:3000
# AXELCOMPTA_ORIGINES=

# -----------------------------------------------------------------------------
# Bridge
# -----------------------------------------------------------------------------
# BRIDGE_CLIENT_ID=
# BRIDGE_CLIENT_SECRET=
# BRIDGE_ENV=sandbox
# BRIDGE_BASE_URL=https://api.bridgeapi.io
# BRIDGE_API_VERSION=2021-06-01

# -----------------------------------------------------------------------------
# Digifactory — adresse et jeton dans Intégrations, pas dans ce fichier.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Rollee — test de contrat sandbox, jamais la production
# -----------------------------------------------------------------------------
# ROLLEE_JETON_SANDBOX=
# ROLLEE_COMPTE_SANDBOX=
# ROLLEE_PLATEFORME_SANDBOX=

# -----------------------------------------------------------------------------
# Logo.dev — clé secrète serveur (sk_…). La clé publiable (pk_…) est dans
# frontend/.env.local : NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY.
# -----------------------------------------------------------------------------
# LOGO_DEV_SECRET_KEY=

# -----------------------------------------------------------------------------
# Base. Le pooler Supabase : utilisateur `<role>.<ref>`, port 5432.
# Les tests d'intégration refusent une base non locale et vident les tables.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL_WEB=postgresql://axelcompta_web.<ref>:<AXELCOMPTA_WEB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# AXELCOMPTA_WEB_PASSWORD=
# DATABASE_URL=postgresql://user:password@localhost:5432/axelcompta_test

# -----------------------------------------------------------------------------
# Supabase Auth — même projet que DATABASE_URL
# -----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_ENV=development
# SECRET_KEY=
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Stockage objet
# -----------------------------------------------------------------------------
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=axelcompta-dev
# S3_REGION=eu-west-1
# MODELES_BUCKET=modeles

# -----------------------------------------------------------------------------
# Modèle de catégorisation
# -----------------------------------------------------------------------------
# ML_MODEL_PATH=_AUDIT_DONNEES/modeles/tfidf_logreg_v1.joblib
# AXELCOMPTA_SANS_MODELE=
# AXELCOMPTA_MODELE_VERSION=tfidf_logreg_v2

# -----------------------------------------------------------------------------
# Registres officiels
# -----------------------------------------------------------------------------
# INSEE_API_KEY=
# INPI_RNE_USERNAME=
# INPI_RNE_PASSWORD=

# -----------------------------------------------------------------------------
# Observabilité. 1 sur AXELCOMPTA_SCHEMA_NON_VERIFIE saute le contrôle
# Alembic au démarrage : poste de dev seulement, jamais en production.
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# METRICS_TOKEN=
# AXELCOMPTA_METRIQUES_FICHIER=
# AXELCOMPTA_SCHEMA_NON_VERIFIE=

# Clé Fernet des intégrations et des liens de désinscription.
# Ne pas en poser une autre que celle de `.env` : les jetons déjà écrits
# deviendraient illisibles.
# AXELCOMPTA_CLE_INTEGRATIONS=

# -----------------------------------------------------------------------------
# IA. L'étage LLM des tâches reste éteint tant que AXELCOMPTA_LLM_ACTIF
# ne vaut pas 1.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=
# AXELCOMPTA_LLM_ACTIF=
# AXELCOMPTA_LLM_MODELE=claude-fable-5-2
# AXELCOMPTA_LLM_PLAFOND_CHAUFFEUR_USD=0.50
# AXELCOMPTA_LLM_PLAFOND_GLOBAL_USD=100

# 1 seulement après avoir lu le bilan de rapprochement Rollee.
# AXELCOMPTA_ROLLEE_RAPPROCHEMENT=

# -----------------------------------------------------------------------------
# Déploiement. Inutile sur le poste. Le front lit les NEXT_PUBLIC_* dans
# frontend/.env.local, pas ici.
# -----------------------------------------------------------------------------
# APP_DOMAIN=
# API_DOMAIN=
# ACME_EMAIL=
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
