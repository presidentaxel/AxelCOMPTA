# Copier en .env. Ne pas committer .env.
# .env.dev, s'il existe, est chargé ensuite et l'emporte.

# Bridge — https://dashboard.bridgeapi.io
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_ENV=sandbox
BRIDGE_BASE_URL=https://api.bridgeapi.io
BRIDGE_API_VERSION=2021-06-01

# Logo.dev, clé secrète (sk_…). La clé publiable (pk_…) va dans frontend/.env.local.
LOGO_DEV_SECRET_KEY=

# Base. DATABASE_URL : rôle propriétaire (migrations, scripts).
# DATABASE_URL_WEB : rôle axelcompta_web, celui de l'API, soumis au RLS.
# Pooler Supabase, port 5432, utilisateur <role>.<ref>.
DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_WEB=postgresql://axelcompta_web.<ref>:<AXELCOMPTA_WEB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
AXELCOMPTA_WEB_PASSWORD=
# Tests d'intégration, base locale seulement :
# DATABASE_URL=postgresql://user:password@localhost:5432/axelcompta_test

# Supabase Auth, même projet que la base. SUPABASE_JWT_SECRET n'est plus lue.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

APP_ENV=development
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=axelcompta-dev
S3_REGION=eu-west-1
MODELES_BUCKET=modeles
# AXE-970 : documents repris des fiches d'import (FEC, liasses, archives…).
# Bucket privé, à créer. Vide : `documents`. Sans S3, les contenus restent en base.
DOCUMENTS_BUCKET=documents

ML_MODEL_PATH=_AUDIT_DONNEES/modeles/tfidf_logreg_v1.joblib
AXELCOMPTA_MODELE_VERSION=tfidf_logreg_v2
# 1 : synchro sans modèle. Développement seulement, jamais en production.
AXELCOMPTA_SANS_MODELE=

# Une seule des deux sources suffit. Vides : les registres ne sont pas relus.
INSEE_API_KEY=
INPI_RNE_USERNAME=
INPI_RNE_PASSWORD=

# Vide : Sentry ne démarre pas. ENV=dev dans .env.dev le coupe aussi.
SENTRY_DSN=
# Vide : /metrics répond 404.
METRICS_TOKEN=
AXELCOMPTA_METRIQUES_FICHIER=
# 1 : saute le contrôle Alembic au démarrage. Poste de dev seulement.
AXELCOMPTA_SCHEMA_NON_VERIFIE=

# Ne plus la changer une fois des intégrations branchées.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AXELCOMPTA_CLE_INTEGRATIONS=

# Vitrine et gestionnaire. Porte d'un dossier : vide, on retombe sur URL_APP.
AXELCOMPTA_URL_APP=http://localhost:3000
# AXELCOMPTA_URL_DOSSIER=https://app-compta.axelproject.fr
# AXELCOMPTA_ORIGINES=

# Webhook Slack des demandes d'échange (https://hooks.slack.com/…).
# Sans lui, les demandes restent en base et l'équipe n'est pas prévenue.
AXELCOMPTA_SLACK_DEMANDES_WEBHOOK=

# Étage LLM éteint tant que AXELCOMPTA_LLM_ACTIF ne vaut pas 1.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=
AXELCOMPTA_LLM_ACTIF=
# AXELCOMPTA_LLM_MODELE=claude-fable-5-2
# AXELCOMPTA_LLM_PLAFOND_CHAUFFEUR_USD=0.50
# AXELCOMPTA_LLM_PLAFOND_GLOBAL_USD=100

# 1 : les tâches posent les liens Rollee sûrs. Vide : elles ne font que lire.
AXELCOMPTA_ROLLEE_RAPPROCHEMENT=

# Droplet seulement. Le front lit les NEXT_PUBLIC_* au build.
# APP_DOMAIN : vitrine et gestionnaire. Porte d'un dossier : AXELCOMPTA_URL_DOSSIER.
# Supabase : https://APP_DOMAIN/auth/lien, plus
# https://app-compta.axelproject.fr/auth/lien et
# https://app-compta.axelproject.fr/dossier/accepter-invitation.
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
