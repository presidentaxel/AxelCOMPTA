# =============================================================================
# AxeLCompta — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env — seul .env.example va en git.
# =============================================================================

# -----------------------------------------------------------------------------
# Bridge (Bankin') — Open Banking / DSP2
# Obtenir les clés sur https://dashboard.bridgeapi.io
# -----------------------------------------------------------------------------
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

# Environnement : sandbox | production
BRIDGE_ENV=sandbox

# URL de base — ne pas modifier sauf migration de version API
BRIDGE_BASE_URL=https://api.bridgeapi.io
BRIDGE_API_VERSION=2021-06-01

# -----------------------------------------------------------------------------
# Digifactory (canal bancaire pilote — doc 16)
# Un accès enregistré dans Intégrations porte son jeton et son adresse.
# Ces variables ne servent que s'il n'y a encore aucun accès Digifactory.
# -----------------------------------------------------------------------------
DIGIFACTORY_TOKEN=
DIGIFACTORY_BASE_URL=https://entrepreneur.digifactory.fr/api/bridge

# -----------------------------------------------------------------------------
# Rollee (revenus Uber/Bolt — doc 13 §3, AXE-818)
# Le jeton de l'application se branche dans l'écran Intégrations (chiffré en
# base), PAS ici. Ces variables ne servent qu'au test de contrat contre le
# sandbox (`python -m pytest -m rollee`), jamais en production :
# - ROLLEE_JETON_SANDBOX : JWT sandbox (tableau de bord Rollee › Settings ›
#   JWT Token) ;
# - ROLLEE_COMPTE_SANDBOX : facultatif, l'identifiant d'un compte relié dans
#   le sandbox, pour vérifier la lecture des revenus et l'unité des montants ;
# - ROLLEE_PLATEFORME_SANDBOX : nom de ce compte (Uber par défaut).
# -----------------------------------------------------------------------------
ROLLEE_JETON_SANDBOX=
ROLLEE_COMPTE_SANDBOX=
ROLLEE_PLATEFORME_SANDBOX=

# -----------------------------------------------------------------------------
# Base de données (PostgreSQL)
# DATABASE_URL : rôle propriétaire (`user`), migrations et scripts
# d'administration (demo_seed, synchro_digifactory, notifier) — jamais
# soumis aux policies RLS (doc 12 §1.1, migration 87fc7238e52e).
# DATABASE_URL_WEB : rôle restreint (`axelcompta_web`), utilisé uniquement
# par `demo_api.py` — soumis aux policies RLS, un dossier/tenant ne voit
# que ses propres lignes. Ne jamais faire tourner l'API avec DATABASE_URL.
# -----------------------------------------------------------------------------
# Depuis le 2026-09-24 (ADR-003), la base de dev et de démo est celle du
# projet Supabase `AxelCompta-demo`. Utiliser le « Session pooler »
# (Dashboard > Connect), port 5432 : la connexion directe
# db.<ref>.supabase.co est en IPv6 seulement. Avec le pooler, l'utilisateur
# s'écrit `<role>.<ref>` : `postgres.<ref>` pour DATABASE_URL,
# `axelcompta_web.<ref>` pour DATABASE_URL_WEB.
# AXELCOMPTA_WEB_PASSWORD : mot de passe du rôle `axelcompta_web`, lu par la
# migration 87fc7238e52e. Obligatoire sur toute base non locale.
DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_WEB=postgresql://axelcompta_web.<ref>:<AXELCOMPTA_WEB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
AXELCOMPTA_WEB_PASSWORD=
# Postgres local (docker-compose) : sert uniquement aux tests d'intégration,
# qui vident toutes les tables et refusent de tourner sur une base non locale.
# DATABASE_URL=postgresql://user:password@localhost:5432/axelcompta_test

# -----------------------------------------------------------------------------
# Supabase Auth (comptes gestionnaire/chauffeur — doc 17 §9 bloc B)
# Décision du 2026-09-08 (voir docs/adr/ADR-003-hebergement.md, mise à
# jour du même jour) : Supabase Auth est retenu au-delà de la démo, y
# compris pour la V1 — ce n'est plus une exception à corriger.
# Même projet Supabase que DATABASE_URL depuis le 2026-09-24 (ADR-003) :
# la décision du 2026-09-07 de garder la base applicative à part est levée.
# Clés dans le dashboard Supabase > Project Settings > API.
# SUPABASE_JWT_SECRET : gardée pour référence mais **plus utilisée** par
# axelcompta.demo_auth depuis le 2026-09-08 — ce projet signe ses jetons
# en ES256 via les « JWT Signing Keys » (JWKS, clé publique), pas en HS256
# avec un secret partagé. Seule SUPABASE_URL sert à la vérification (voir
# le commentaire de module de demo_auth.py).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Stockage objet (MinIO local ou S3 en prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=axelcompta-dev

# -----------------------------------------------------------------------------
# ML — chemins des modèles (relatif ou absolu)
# -----------------------------------------------------------------------------
ML_MODEL_PATH=_AUDIT_DONNEES/modeles/tfidf_logreg_v1.joblib
# AXE-825 : sans le modèle (_AUDIT_DONNEES/modeles/tfidf_logreg_v2.joblib), la
# synchro s'arrête. « 1 » permet de continuer avec les règles seules :
# développement et tests uniquement, jamais en production.
AXELCOMPTA_SANS_MODELE=
# AXE-847 : version attendue du modèle (fichier <version>.joblib). Si elle
# manque sur le poste, elle est récupérée du bucket privé MODELES_BUCKET
# (stockage S3 ci-dessus) au démarrage du worker, de la synchro et de l'API,
# empreinte vérifiée. Publier une version : scripts/publier_modele.py.
AXELCOMPTA_MODELE_VERSION=tfidf_logreg_v2
MODELES_BUCKET=modeles
S3_REGION=eu-west-1

# -----------------------------------------------------------------------------
# Registres officiels (AXE-849) : relus une fois par semaine par les tâches
# planifiées. Secrets, jamais dans le dépôt. Sans aucune des clés, rien
# n'est lu. Une seule des deux suffit : l'autre manque simplement à la fiche.
#
# INSEE — « API Sirene » 3.11 sur portail-api.insee.fr (pas la V4).
# Le code appelle https://api.insee.fr/api-sirene/3.11 et envoie la clé
# d'intégration dans l'en-tête X-INSEE-Api-Key-Integration.
# Donne la dénomination, la forme (sans distinguer SAS/SASU), le siège,
# l'état et l'activité. Lecture vérifiée le 2026-11-11.
#
# RNE — compte sur data.inpi.fr. Donne le capital, les dirigeants et
# l'associé unique (SAS ou SASU). Laisser vide tant que le compte n'existe
# pas : l'INSEE est lu quand même.
#
# Vérifier, sans rien écrire (charge le .env racine) :
#   python -m axelcompta.registres_officiels --siren 989841911
# -----------------------------------------------------------------------------
INSEE_API_KEY=
INPI_RNE_USERNAME=
INPI_RNE_PASSWORD=

# -----------------------------------------------------------------------------
# Observabilité (doc 15). Vide : Sentry ne démarre pas, rien n'est envoyé.
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Jeton de lecture de /metrics (AXE-810). Vide : /metrics répond 404.
# Le collecteur envoie « Authorization: Bearer <jeton> ».
METRICS_TOKEN=

# Fichier où les tâches planifiées écrivent leurs métriques (format texte
# Prometheus, lu par le collecteur), dont balance_desequilibree_total (AXE-807).
# Vide : pas de fichier.
AXELCOMPTA_METRIQUES_FICHIER=

# Vérification du schéma au démarrage de l'API (AXE-841). Vide : l'API
# refuse de démarrer si la base n'est pas à la tête Alembic du code.
# 1 : vérification sautée (poste de dev seulement, jamais en production).
AXELCOMPTA_SCHEMA_NON_VERIFIE=


# AXE-808 / AXE-872 : clé de chiffrement des identifiants d'intégration (SMTP,
# SMS, jetons Digifactory) et de signature des liens de désinscription. Jamais
# en base. Nécessaire sur l'API, le worker ET les tâches planifiées (la
# synchro Digifactory déchiffre son jeton). Ne jamais la changer une fois des
# intégrations branchées : elles deviendraient illisibles. Générer :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AXELCOMPTA_CLE_INTEGRATIONS=
# Adresse publique de l'espace chauffeur, pour les liens des rappels.
AXELCOMPTA_URL_APP=http://localhost:3000

# -----------------------------------------------------------------------------
# IA (AXE-888, AXE-887). Jamais d'appel en direct depuis l'API. Sur le poste
# qui lance `scripts/proposer_ia.py` ou les tâches planifiées :
# `cd backend && uv sync --extra llm`.
#
# ANTHROPIC_API_KEY : clé Anthropic. Un workspace dédié à AxeLCompta, avec une
# limite de dépense posée dans la console (plus basse en dev).
# ANTHROPIC_WORKSPACE_ID : identifiant wrkspc_… (console → Workspaces, colonne
# ID). Obligatoire si la clé n'est pas limitée à un seul workspace. Vide si
# la clé a été créée dans ce workspace.
# ANTHROPIC_MODEL : modèle du script `scripts/proposer_ia.py`. Vide =
# claude-fable-5-2. `--modele` l'emporte.
#
# L'étage LLM des tâches planifiées est éteint tant que AXELCOMPTA_LLM_ACTIF
# ne vaut pas 1. AXELCOMPTA_LLM_MODELE choisit son modèle (vide =
# claude-fable-5-2). Plafonds par défaut : 0,50 $ par chauffeur et par mois,
# 100 $ par mois au global.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=
AXELCOMPTA_LLM_ACTIF=
# AXELCOMPTA_LLM_MODELE=claude-fable-5-2
# AXELCOMPTA_LLM_PLAFOND_CHAUFFEUR_USD=0.50
# AXELCOMPTA_LLM_PLAFOND_GLOBAL_USD=100
